# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and editor state
.venv/
venv/
env/
.env
.env.*
.idea/
.vscode/
*.swp
*~

# Packaging and build products
build/
dist/
*.egg-info/

# Large root-level FDTD arrays and generated forward-run binaries/figures.
# Lightweight JSON/Markdown validation summaries under results/ remain tracked.
/*.npy
/results/**/*.npz
/results/**/*.png
/results/solver_comparisons/current/

# Generated scratch diagnostics; keep the scripts themselves tracked.
/scratchpad/**/*.csv

# Keep literature citations/links in Git, not redistributed article PDFs.
/references/*.pdf

# Large third-party source trees. Project-owned wrappers in solvers/ remain tracked.
/bembel/
/bempp-cl/
/gprMax/
/ngbem/
/scuff-em/
/bem_gradients/
/layered_Green_function/

# Checked validation bundles are deliberately small and reviewable.  Generated
# studies still obey the broad /results/**/*.npz and *.png exclusions above;
# only these named evidence snapshots retain their binary inputs/plots in Git.
!/results/solver_comparisons/legacy/qbx-closeout-20260901/**/*.npz
!/results/solver_comparisons/legacy/qbx-closeout-20260901/**/*.png
!/results/sdf_boundary_parameterization/smoke-20260902/**/*.npz
!/results/sdf_boundary_parameterization/smoke-20260902/**/*.png
!/results/sdf_boundary_parameterization/kress-scalar-proxy-20260902/**/*.npz
