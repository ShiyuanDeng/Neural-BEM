# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and editor state
.DS_Store
.venv/
venv/
env/
.env
.env.*
.idea/
.vscode/
*.swp
*~

# Packaging and build products
build/
dist/
*.egg-info/

# Large root-level FDTD arrays and generated forward-run binaries/figures.
# Lightweight JSON/Markdown validation summaries under results/ remain tracked.
/*.npy
/results/**/*.npz
/results/**/*.png
/results/**/*.mp4
/results/**/*.pt
/results/validation/solver_comparisons/current/

# Generated scratch diagnostics; keep the scripts themselves tracked.
/scratchpad/**/*.csv

# Per-weight neural inverse trajectories: one column per network weight, tens
# of MB per run. metrics.json and summary.md carry the textual record.
/results/validation/implicit_mlp_adjoint/rerun-20260907/**/kress_trajectory.csv
/results/inverse/implicit_mlp/**/kress_trajectory.csv
/results/validation/implicit_mlp_adjoint/latest-direction-20260908/**/kress_trajectory.csv

# Keep literature citations/links in Git, not redistributed article PDFs.
/references/*.pdf

# Large third-party source trees. Project-owned wrappers in solvers/ remain tracked.
/bembel/
/bempp-cl/
/gprMax/
/ngbem/
/scuff-em/
/bem_gradients/
/layered_Green_function/

# Checked validation bundles are deliberately small and reviewable.  Generated
# studies still obey the broad /results/**/*.npz and *.png exclusions above;
