+        self.reserve(len(items))  # complete batch, before a pool starts any work
+        def dispatched(item):
+            with self._lock:
+                self.reserve(1)
+                self.charge(kind, category)
+            try:
+                return function(item)
+            except Exception:
+                with self._lock:
+                    self.fail(category)
+                raise
+        with calls_for(dispatched, items) as calls:
